{
  "id": "wechat_hit_detector",
  "name": "发布前复核",
  "version": "1.0.0",
  "description": "检查公众号文章标题承诺、正文价值、事实边界和发布风险。",
  "capabilities": ["review", "risk_check", "rewrite"],
  "tools": [
    {
      "name": "review_article",
      "description": "复核现有公众号文章但不改正文",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "body": {"type": "string"},
          "track": {"type": "string", "default": "auto"}
        },
        "required": ["body"],
        "additionalProperties": false
      }
    },
    {
      "name": "rewrite_article",
      "description": "根据复核结果做最小必要改稿",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "body": {"type": "string"},
          "detector_result": {"type": "object"}
        },
        "required": ["body"],
        "additionalProperties": false
      }
    }
  ],
  "pricing": {"base_points": 3},
  "model_policy": {"text": "default_text"},
  "limits": {"timeout_seconds": 180, "max_tool_calls": 6},
  "trusted": true
}
