REDFOX_API_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Production persistence and durable task execution
APP_ENV=production
# HTTPS production sessions; local HTTP development may explicitly set 0.
CREATOR_COOKIE_SECURE=1
# Pin the actual reverse proxy peer(s), including the Docker bridge gateway
# when host nginx forwards to the loopback-published container. Never use *.
TRUSTED_PROXY_IPS=127.0.0.1
AUTH_RATE_LIMIT_ENABLED=1
AUTH_LOGIN_IP_LIMIT=60
AUTH_REGISTER_IP_LIMIT=20
POSTGRES_DB=universe
POSTGRES_USER=universe
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://universe:replace-with-a-long-random-password@postgres:5432/universe
REDIS_URL=redis://redis:6379/0

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
WEB_WORKERS=1
CELERY_WORKER_CONCURRENCY=2
CELERY_NODE_SOFT_TIME_LIMIT=300
CELERY_NODE_TIME_LIMIT=330
WECHAT_SKILL_HOST_PATH=/opt/universe-skills/weChat-autoCreate
LEGACY_DATA_HOST_PATH=/opt/universe-data/legacy
WORKBENCH_OUTPUT_HOST_PATH=/opt/universe-data/output

# Artifact storage. Keep local for development; use s3 for S3/R2/OSS-compatible storage.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/app/output/storage
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_PREFIX=artifacts
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_URL_EXPIRY_SECONDS=900

# Distributed limits for expensive Agent submissions
AGENT_RATE_WINDOW_SECONDS=60
AGENT_RATE_USER_PER_MINUTE=10
AGENT_RATE_IP_PER_MINUTE=30
AGENT_RATE_SKILL_PER_MINUTE=8

# 内容工作台：文本与图片密钥必须分开配置
WECHAT_TEXT_API_KEY=
WECHAT_IMAGE_API_KEY=
WECHAT_TEXT_API_BASE_URL=https://api.openai.com/v1
WECHAT_IMAGE_API_BASE_URL=https://api.openai.com/v1
WECHAT_TEXT_MODEL=gpt-6.1-sol
WECHAT_REASONING_EFFORT=medium
# 设为 0 可关闭本批新增的初稿写作规则。
WECHAT_WRITING_QUALITY_V1=1
WECHAT_REVIEW_ROUNDS=1
WECHAT_REVIEW_TIMEOUT=240
WECHAT_REVIEW_REQUEST_TIMEOUT=120
WECHAT_IMAGE_MODEL=gpt-image-2
# Provider prices in micro currency units. Configure from the vendor's current bill.
WECHAT_TEXT_INPUT_MICROS_PER_MILLION_TOKENS=0
WECHAT_TEXT_OUTPUT_MICROS_PER_MILLION_TOKENS=0
WECHAT_IMAGE_MICROS_EACH=0
WECHAT_API_ACTOR_AUTH=
WECHAT_API_VERIFY_SSL=true
# Path to the reviewed Easel checkout's skills/openclaw directory.
EASEL_SKILLS_ROOT=
# Enables the first ten text-only Native Skills in the catalog.
EASEL_NATIVE_ENABLED=0
